{
  "name": "@dsh-external/dsh-music",
  "version": "0.6.2",
  "description": "这是一个可以让你边对话边听歌的 DeepSeek Harness 插件：可一键关闭/重开的悬浮播放器（默认收缩成小唱片圈吸附贴边，双击下一首/三击上一首），接入QQ音乐（官方接口解析），支持扫码登录QQ音乐账号（解锁VIP播放与「我喜欢」）、断点续播、音质切换、重启续播、歌单导入和搜索；在设置-插件中可查看状态并显示/隐藏播放器。dsh-MusicPlayer: chat and listen at the same time.",
  "repository": {
    "type": "git",
    "url": "https://github.com/xiekai886/dsh-MusicPlayer.git"
  },
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml"
  ],
  "scripts": {
    "check": "node --check index.js && node --check client.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6",
    "@deepseek-ai/schemastery": "^3.18.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "license": "MIT"
}
